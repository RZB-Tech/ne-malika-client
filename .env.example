# Адрес бэкенда. Без него клиент идёт в http://localhost:3001 — на проде это
# молча пустая витрина, поэтому в сборку образа переменную передаём всегда.
NEXT_PUBLIC_API_URL=

# Внутренний адрес того же бэкенда для серверного рендера: внутри docker-сети
# фронтенд ходит напрямую по имени сервиса (http://api:3000), не гоняя трафик
# через публичный TLS. Не задан — берётся NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Публичный адрес сайта: из него собираются canonical, sitemap и og:url.
# По умолчанию https://nemalika.uz.
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_YANDEX_SUGGEST_KEY=

# Числовой id бота — вход через Telegram OAuth.
NEXT_PUBLIC_TELEGRAM_BOT_ID=

# Username бота без «@» — из него собирается ссылка t.me/<username>, по которой
# продавец открывает чат и нажимает «Старт». Без этого шага бот не имеет права
# написать первым, и уведомления не доходят.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Статистика карточки товара в кабинете продавца (просмотры, раскрытия телефона,
# переходы в Telegram). Читает /api/metrika/product-stats.
#
# Переменные рантайма, не NEXT_PUBLIC_: в бандл не попадают, в build-args
# Dockerfile не нужны — задаются в .env рядом с docker-compose.prod.yml.
#
# Токен — OAuth Яндекса с правом metrika:read, выданный аккаунту, у которого есть
# доступ к счётчику. Он открывает все счётчики этого аккаунта, поэтому живёт
# только на сервере. Без обеих переменных роут отвечает 501, и продавец видит
# ошибку вместо цифр.
YANDEX_METRIKA_TOKEN=
# Тот же счётчик, что вшит в клиентский скрипт — METRIKA_COUNTER_ID в lib/metrika.ts.
YANDEX_METRIKA_COUNTER_ID=
