# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.idea/

# dependencies
/node_modules
/.pnp
.pnp.*
# Пакетный менеджер здесь только pnpm — им ставит и Dockerfile, и CI. Чужой
# lock-файл от случайного `npm i` разъедется с pnpm-lock и однажды соберёт
# другой набор версий.
package-lock.json
yarn.lock
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# Сборка в отдельную папку (NEXT_DIST_DIR) — так проверочный build не мешает
# запущенному `next dev`.
/.next-*/

# production
/build

# misc
.DS_Store
# Windows создаёт их сам в любой открытой в проводнике папке.
Thumbs.db
desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
